# Development-only settings, no secrets. bin/dev and bin/setup copy this file
# to .env (git-ignored) when it is missing; edit .env locally.
# Every variable has a safe default in code — see docs/conventions/code.md.

# Host port of the Postgres container. Not 5432, so Rubedo runs next to
# other projects that use the default port.
DB_PORT=5433
